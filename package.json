{
  "name": "jest-axe",
  "version": "11.0.0",
  "description": "Custom Jest matcher for aXe for testing accessibility",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NickColley/jest-axe"
  },
  "main": "index.js",
  "files": [
    "index.js",
    "extend-expect.js"
  ],
  "scripts": {
    "test": "npm run lint && npm run jest",
    "jest": "FORCE_COLOR=0 jest",
    "lint": "npx @biomejs/biome check"
  },
  "keywords": [
    "jest",
    "matcher",
    "axe",
    "accessibility",
    "a11y"
  ],
  "author": "Nick Colley",
  "license": "MIT",
  "engines": {
    "node": ">= 18.0.0"
  },
  "dependencies": {
    "axe-core": "4.12.1",
    "chalk": "4.1.2",
    "jest-matcher-utils": "30.4.1",
    "lodash.merge": "4.6.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@testing-library/react": "^16.3.2",
    "@testing-library/vue": "^8.1.0",
    "@vue/test-utils": "^2.4.11",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "vue": "^3.5.40"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "testEnvironmentOptions": {
      "customExportConditions": [
        "node",
        "node-addons"
      ]
    }
  }
}
